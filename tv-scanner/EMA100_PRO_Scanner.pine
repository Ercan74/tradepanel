//====================================================
// TABLE ARRAYS
//====================================================
var rowSymbols = array.new_string()
var rowPrice = array.new_float()
var rowDist = array.new_float()
var rowRsi = array.new_float()
var rowMacd = array.new_float()
var rowHist = array.new_float()
var rowSlope = array.new_float()
var rowFib = array.new_int()
var rowS1 = array.new_float()
var rowS2 = array.new_float()
var rowR1 = array.new_float()
var rowR2 = array.new_float()
var rowCross = array.new_int()
var rowState = array.new_int()
var rowRisk = array.new_int()
var rowAction = array.new_int()
var rowActionInt = array.new_int()
var rowScore = array.new_float()
var rowEntry = array.new_float()
var rowStop = array.new_float()
var rowTarget = array.new_float()
var rowQuality = array.new_float()
var rowSize = array.new_float()

f_resetRows() =>
    array.clear(rowSymbols)
    array.clear(rowPrice)
    array.clear(rowDist)
    array.clear(rowRsi)
    array.clear(rowMacd)
    array.clear(rowHist)
    array.clear(rowSlope)
    array.clear(rowFib)
    array.clear(rowS1)
    array.clear(rowS2)
    array.clear(rowR1)
    array.clear(rowR2)
    array.clear(rowCross)
    array.clear(rowState)
    array.clear(rowRisk)
    array.clear(rowAction)
    array.clear(rowActionInt)
    array.clear(rowScore)
    array.clear(rowEntry)
    array.clear(rowStop)
    array.clear(rowTarget)
    array.clear(rowQuality)
    array.clear(rowSize)

f_addRow(_sym, _price, _dist, _rsi, _macd, _hist, _slope, _fib, _s1, _s2, _r1, _r2, _cross, _state, _risk, _action, _actionInt, _score, _entry) =>
    _stop = f_tradeStop(_action, _s1, _r1)
    _target = f_tradeTarget(_action, _s2, _r2)
    _quality = f_qualityScore(_dist, _rsi, _slope, _state, _risk, _action, _actionInt)
    _size = f_positionSize(_entry, _stop)
    if _sym != "__NONE" and f_directionOk(_action)
        array.push(rowSymbols, _sym)
        array.push(rowPrice, _price)
        array.push(rowDist, _dist)
        array.push(rowRsi, _rsi)
        array.push(rowMacd, _macd)
        array.push(rowHist, _hist)
        array.push(rowSlope, _slope)
        array.push(rowFib, _fib)
        array.push(rowS1, _s1)
        array.push(rowS2, _s2)
        array.push(rowR1, _r1)
        array.push(rowR2, _r2)
        array.push(rowCross, _cross)
        array.push(rowState, _state)
        array.push(rowRisk, _risk)
        array.push(rowAction, _action)
        array.push(rowActionInt, _actionInt)
        array.push(rowScore, _score)
        array.push(rowEntry, _entry)
        array.push(rowStop, _stop)
        array.push(rowTarget, _target)
        array.push(rowQuality, _quality)
        array.push(rowSize, _size)

f_swap(_i, _j) =>
    tSym = array.get(rowSymbols, _i)
    tPrice = array.get(rowPrice, _i)
    tDist = array.get(rowDist, _i)
    tRsi = array.get(rowRsi, _i)
    tMacd = array.get(rowMacd, _i)
    tHist = array.get(rowHist, _i)
    tSlope = array.get(rowSlope, _i)
    tFib = array.get(rowFib, _i)
    tS1 = array.get(rowS1, _i)
    tS2 = array.get(rowS2, _i)
    tR1 = array.get(rowR1, _i)
    tR2 = array.get(rowR2, _i)
    tCross = array.get(rowCross, _i)
    tState = array.get(rowState, _i)
    tRisk = array.get(rowRisk, _i)
    tAction = array.get(rowAction, _i)
    tActionInt = array.get(rowActionInt, _i)
    tScore = array.get(rowScore, _i)
    tEntry = array.get(rowEntry, _i)
    tStop = array.get(rowStop, _i)
    tTarget = array.get(rowTarget, _i)
    tQuality = array.get(rowQuality, _i)
    tSize = array.get(rowSize, _i)

    array.set(rowSymbols, _i, array.get(rowSymbols, _j))
    array.set(rowPrice, _i, array.get(rowPrice, _j))
    array.set(rowDist, _i, array.get(rowDist, _j))
    array.set(rowRsi, _i, array.get(rowRsi, _j))
    array.set(rowMacd, _i, array.get(rowMacd, _j))
    array.set(rowHist, _i, array.get(rowHist, _j))
    array.set(rowSlope, _i, array.get(rowSlope, _j))
    array.set(rowFib, _i, array.get(rowFib, _j))
    array.set(rowS1, _i, array.get(rowS1, _j))
    array.set(rowS2, _i, array.get(rowS2, _j))
    array.set(rowR1, _i, array.get(rowR1, _j))
    array.set(rowR2, _i, array.get(rowR2, _j))
    array.set(rowCross, _i, array.get(rowCross, _j))
    array.set(rowState, _i, array.get(rowState, _j))
    array.set(rowRisk, _i, array.get(rowRisk, _j))
    array.set(rowAction, _i, array.get(rowAction, _j))
    array.set(rowActionInt, _i, array.get(rowActionInt, _j))
    array.set(rowScore, _i, array.get(rowScore, _j))
    array.set(rowEntry, _i, array.get(rowEntry, _j))
    array.set(rowStop, _i, array.get(rowStop, _j))
    array.set(rowTarget, _i, array.get(rowTarget, _j))
    array.set(rowQuality, _i, array.get(rowQuality, _j))
    array.set(rowSize, _i, array.get(rowSize, _j))

    array.set(rowSymbols, _j, tSym)
    array.set(rowPrice, _j, tPrice)
    array.set(rowDist, _j, tDist)
    array.set(rowRsi, _j, tRsi)
    array.set(rowMacd, _j, tMacd)
    array.set(rowHist, _j, tHist)
    array.set(rowSlope, _j, tSlope)
    array.set(rowFib, _j, tFib)
    array.set(rowS1, _j, tS1)
    array.set(rowS2, _j, tS2)
    array.set(rowR1, _j, tR1)
    array.set(rowR2, _j, tR2)
    array.set(rowCross, _j, tCross)
    array.set(rowState, _j, tState)
    array.set(rowRisk, _j, tRisk)
    array.set(rowAction, _j, tAction)
    array.set(rowActionInt, _j, tActionInt)
    array.set(rowScore, _j, tScore)
    array.set(rowEntry, _j, tEntry)
    array.set(rowStop, _j, tStop)
    array.set(rowTarget, _j, tTarget)
    array.set(rowQuality, _j, tQuality)
    array.set(rowSize, _j, tSize)

f_sort() =>
    sz = array.size(rowSymbols)
    if sz > 1
        for i = 0 to sz - 2
            for j = 0 to sz - 2 - i
                if array.get(rowQuality, j + 1) > array.get(rowQuality, j)
                    f_swap(j, j + 1)

// Portfolio exposure governor: scales all actionable position sizes proportionally
// when total proposed exposure is above Max Total Exposure %.
f_applyExposureCap() =>
    if capPositionSizeToMaxExposure and accountSize > 0
        sz = array.size(rowSymbols)
        rawExposure = 0.0
        for i = 0 to sz - 1
            a = array.get(rowAction, i)
            ps = array.get(rowSize, i)
            ent = array.get(rowEntry, i)
            if not na(ps) and not na(ent) and (a != 0 and a != 9)
                rawExposure += ps * ent
        maxExposureValue = accountSize * (maxExposurePct / 100.0)
        scale = rawExposure > maxExposureValue and rawExposure > 0 ? maxExposureValue / rawExposure : 1.0
        if scale < 1.0
            for i = 0 to sz - 1
                ps = array.get(rowSize, i)
                if not na(ps)
                    array.set(rowSize, i, ps * scale)

//====================================================
// BUILD TABLE ROWS
//====================================================
f_resetRows()
f_addRow(f_stripExchange(scanSym1), s1c, s1d, s1r, s1m, s1h, s1s, s1f, s1s1, s1s2, s1r1, s1r2, s1x, s1st, s1rk, s1ac, s1ai, s1sc, s1entry)
