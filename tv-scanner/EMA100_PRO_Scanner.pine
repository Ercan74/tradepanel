scanSym28 = presetList == "CUSTOM" ? "BIST:__NONE" : presetList == "BIST 01: ACSEL-ANHYT (30)" ? "BIST:ALVES" : presetList == "BIST 02: ANSGR-BIMAS (30)" ? "BIST:BFREN" : presetList == "BIST 03: BINHO-CVKMD (30)" ? "BIST:CRFSA" : presetList == "BIST 04: CWENE-ECILC (30)" ? "BIST:DZGYO" : presetList == "BIST 05: ECZYT-FONET (30)" ? "BIST:FLAP" : presetList == "BIST 06: FORMT-HKTM (30)" ? "BIST:HEDEF" : presetList == "BIST 07: HLGYO-IZINV (30)" ? "BIST:ISYAT" : presetList == "BIST 08: IZMDC-KRDMD (30)" ? "BIST:KRDMA" : presetList == "BIST 09: KRONT-MEKAG (30)" ? "BIST:MEGAP" : presetList == "BIST 10: MEPET-OTKAR (30)" ? "BIST:OSMEN" : presetList == "BIST 11: OTTO-PSGYO (30)" ? "BIST:PRKME" : presetList == "BIST 12: QUAGR-SILVR (30)" ? "BIST:SELVA" : presetList == "BIST 13: SISE-TRALT (30)" ? "BIST:TMSN" : presetList == "BIST 14: TRCAS-VESTL (30)" ? "BIST:VERUS" : presetList == "BIST 15: VKFYO-ZRGYO (last)" ? "BIST:__NONE" : "BIST:__NONE"
scanSym29 = presetList == "CUSTOM" ? "BIST:__NONE" : presetList == "BIST 01: ACSEL-ANHYT (30)" ? "BIST:ANELE" : presetList == "BIST 02: ANSGR-BIMAS (30)" ? "BIST:BIENY" : presetList == "BIST 03: BINHO-CVKMD (30)" ? "BIST:CUSAN" : presetList == "BIST 04: CWENE-ECILC (30)" ? "BIST:EBEBK" : presetList == "BIST 05: ECZYT-FONET (30)" ? "BIST:FMIZP" : presetList == "BIST 06: FORMT-HKTM (30)" ? "BIST:HEKTS" : presetList == "BIST 07: HLGYO-IZINV (30)" ? "BIST:IZFAS" : presetList == "BIST 08: IZMDC-KRDMD (30)" ? "BIST:KRDMB" : presetList == "BIST 09: KRONT-MEKAG (30)" ? "BIST:MEGMT" : presetList == "BIST 10: MEPET-OTKAR (30)" ? "BIST:OSTIM" : presetList == "BIST 11: OTTO-PSGYO (30)" ? "BIST:PSDTC" : presetList == "BIST 12: QUAGR-SILVR (30)" ? "BIST:SEYKM" : presetList == "BIST 13: SISE-TRALT (30)" ? "BIST:TOASO" : presetList == "BIST 14: TRCAS-VESTL (30)" ? "BIST:VESBE" : presetList == "BIST 15: VKFYO-ZRGYO (last)" ? "BIST:__NONE" : "BIST:__NONE"
scanSym30 = presetList == "CUSTOM" ? "BIST:__NONE" : presetList == "BIST 01: ACSEL-ANHYT (30)" ? "BIST:ANHYT" : presetList == "BIST 02: ANSGR-BIMAS (30)" ? "BIST:BIMAS" : presetList == "BIST 03: BINHO-CVKMD (30)" ? "BIST:CVKMD" : presetList == "BIST 04: CWENE-ECILC (30)" ? "BIST:ECILC" : presetList == "BIST 05: ECZYT-FONET (30)" ? "BIST:FONET" : presetList == "BIST 06: FORMT-HKTM (30)" ? "BIST:HKTM" : presetList == "BIST 07: HLGYO-IZINV (30)" ? "BIST:IZINV" : presetList == "BIST 08: IZMDC-KRDMD (30)" ? "BIST:KRDMD" : presetList == "BIST 09: KRONT-MEKAG (30)" ? "BIST:MEKAG" : presetList == "BIST 10: MEPET-OTKAR (30)" ? "BIST:OTKAR" : presetList == "BIST 11: OTTO-PSGYO (30)" ? "BIST:PSGYO" : presetList == "BIST 12: QUAGR-SILVR (30)" ? "BIST:SILVR" : presetList == "BIST 13: SISE-TRALT (30)" ? "BIST:TRALT" : presetList == "BIST 14: TRCAS-VESTL (30)" ? "BIST:VESTL" : presetList == "BIST 15: VKFYO-ZRGYO (last)" ? "BIST:__NONE" : "BIST:__NONE"

tfToUse = scanTf == "" ? timeframe.period : scanTf

//====================================================
// HELPERS
//====================================================
f_tablePos(_p) =>
    _p == "top_left" ? position.top_left :
     _p == "top_right" ? position.top_right :
     _p == "middle_right" ? position.middle_right :
     _p == "bottom_left" ? position.bottom_left :
     position.bottom_right

f_textSize(_s) =>
    _s == "tiny" ? size.tiny : _s == "normal" ? size.normal : size.small

f_stripExchange(_ticker) =>
    out = _ticker
    p = str.pos(_ticker, ":")
    if p >= 0
        out := str.substring(_ticker, p + 1, str.length(_ticker))
    out

f_exchangeOnly(_ticker) =>
    out = ""
    p = str.pos(_ticker, ":")
    if p >= 0
        out := str.substring(_ticker, 0, p)
    out

f_json_num(_v) =>
    na(_v) ? "null" : str.tostring(_v)

f_fmt2(_v) =>
    na(_v) ? "na" : str.tostring(_v, "#.00")

f_fmt3(_v) =>
    na(_v) ? "-" : str.tostring(_v, "#.000")

f_fmtPrice(_v) =>
    na(_v) ? "-" : str.tostring(_v, format.mintick)

f_crossText(_v) =>
    _v == 1 ? "UP" : _v == -1 ? "DOWN" : "-"

f_stateText(_state) =>
    _state == 3 ? "EXTREME_LONG" :
     _state == 2 ? "READY_LONG" :
     _state == 1 ? "TREND_LONG" :
     _state == -1 ? "TREND_SHORT" :
     _state == -2 ? "READY_SHORT" :
     _state == -3 ? "EXTREME_SHORT" :
     "NEUTRAL"

f_fibZoneText(_code) =>
    _code == 236 ? "0.236" :
     _code == 382 ? "0.382" :
     _code == 500 ? "0.500" :
     _code == 618 ? "0.618" :
     _code == 786 ? "0.786" :
     "na"

f_stateBg(_state) =>
    c = color.new(color.gray, 78)
    if _state == 2
        c := color.new(color.lime, 45)
    else if _state == -2
        c := color.new(color.red, 45)
    else if _state == 3
        c := color.new(color.green, 78)
    else if _state == -3
        c := color.new(color.maroon, 78)
    else if _state == 1
        c := color.new(color.teal, 84)
    else if _state == -1
        c := color.new(color.orange, 84)
    c

f_distBg(_dist) =>
    c = color.new(color.gray, 92)
    if not na(_dist)
        if _dist <= -3
            c := color.new(color.green, 15)
        else if _dist <= -2
            c := color.new(color.green, 45)
        else if _dist <= -1
            c := color.new(color.green, 70)
        else if _dist < 1
            c := color.new(color.gray, 88)
        else if _dist < 2
            c := color.new(color.red, 70)
        else if _dist < 3
            c := color.new(color.red, 45)
        else
            c := color.new(color.red, 15)
    c

f_actionText(_action, _intensity) =>
    _action == 5 ? "CONFIRMED BUY" :
     _action == 4 ? "EARLY BUY" :
     _action == 2 ? (_intensity == 1 ? "WATCH LONG+" : "WATCH LONG") :
     _action == 1 ? "WATCH LONG" :
     _action == -1 ? "WATCH SHORT" :
     _action == -2 ? (_intensity == 1 ? "WATCH SHORT+" : "WATCH SHORT") :
     _action == -4 ? "EARLY SELL" :
     _action == -5 ? "CONFIRMED SELL" :
     _action == 9 ? "WAIT_RISK" :
     "WAIT"

f_actionBg(_action, _intensity) =>
    c = color.new(color.gray, 90)
    if _action == 5
        c := color.new(color.green, 0)
    else if _action == 4
        c := color.new(color.green, 55)
    else if _action == 2
        c := _intensity == 1 ? color.new(color.teal, 0) : color.new(color.teal, 35)
    else if _action == 1
        c := color.new(color.teal, 55)
    else if _action == -1
        c := color.new(color.orange, 55)
    else if _action == -2
        c := _intensity == 1 ? color.new(color.red, 0) : color.new(color.red, 30)
    else if _action == -4
        c := color.new(color.red, 55)
    else if _action == -5
        c := color.new(color.maroon, 8)
    else if _action == 9
        c := color.new(color.yellow, 35)
    c

f_actionTextColor(_action) =>
    _action == 5 or _action == -5 ? color.white : color.black

f_directionOk(_action) =>
    directionFilter == "LONG_ONLY" ? _action > 0 :
     directionFilter == "SHORT_ONLY" ? _action < 0 :
     true

f_alertQty(_side, _entry, _s1, _r1) =>
    stopForQty = _side == "BUY" ? _s1 : _r1
    riskAmount = accountSize * (riskPercent / 100.0)
    stopDist = not na(_entry) and not na(stopForQty) ? math.abs(_entry - stopForQty) : na
    autoQty = not na(stopDist) and stopDist > 0 ? riskAmount / stopDist : defaultQty
    useAutoSizeForAlert ? autoQty : defaultQty

f_qualityBand(_q) =>
    na(_q) ? "NA" : _q >= 90 ? "A+" : _q >= 80 ? "A" : _q >= 70 ? "B+" : _q >= minQualityScore ? "B" : _q >= 40 ? "C" : "D"

f_triggerStatus(_action, _price, _entry) =>
    txt = "NA"
    if not na(_price) and not na(_entry) and _action != 0 and _action != 9
        distPct = math.abs(_entry - _price) / _price * 100.0
        isTriggered = _action > 0 ? _price >= _entry : _price <= _entry
        txt := isTriggered ? "TRIGGER" : distPct <= nearEntryPct ? "NEAR" : "ARMED"
    txt


// Webhook Quality Score — Faz-2a: GERÇEK YAYILIM (68-100).
// f_execJson() yalnız CONFIRMED için ateşler. Eski tasarım action'a sabitti (hep
// 92-100) → SWAP +40 kapısı ve havuz-75 tabanı işlevsizdi ("95+ gönder" imkânsızdı).
// Yeni: taban 68, faktörler skoru 68-100'e YAYAR. Tüm faktörler per-sembol güvenilir
// (f_engine'den gelir). Haftalık bias KATILMAZ — chart-level bug (30 sembolün 29'u
// için yanlış; bkz. "WEEKLY BIAS" bloğu). _macdBelow = macdLine[1] < 0.
f_execQualityScore(_dist, _rsi, _slope, _state, _side, _macdBelow) =>
    base = 68.0
    tech = 0.0
    // distATR tatlı-nokta: EMA100'e ~3 ATR pullback ideal; çok sığ/çok derin az puan
    ad = na(_dist) ? 0.0 : math.abs(_dist)
    tech += ad <= 3.0 ? ad * 3.0 : math.max(0.0, 9.0 - (ad - 3.0) * 2.0)   // 0..9 (tepe ad=3)
    // RSI ivmesi: 50'den uzaklık = dönüş gücü
    if not na(_rsi)
        tech += math.min(math.abs(_rsi - 50.0) / 3.0, 8.0)                 // 0..8
    // Slope: trend eğimi
    if not na(_slope)
        tech += math.min(math.abs(_slope) * 8.0, 7.0)                      // 0..7
    // MACD sıfır bölgesi: BUY sıfır-altından, SELL sıfır-üstünden kesiş daha güçlü dönüş
    macdZoneStrong = _side == "BUY" ? _macdBelow : not _macdBelow
    if macdZoneStrong
        tech += 8.0                                                        // 0 veya 8
    // READY (±2) EXTREME'den (±3) biraz daha temiz zamanlama
    if math.abs(_state) == 2
        tech += 3.0                                                        // 0 veya 3
    math.min(100.0, base + tech)

f_execJson(_symbol, _side, _price, _rsi, _dist, _macd, _hist, _cross, _slope, _state, _s1, _s2, _r1, _r2, _weeklyBull, _weeklyBear, _macdBelow) =>
    msg = "{"
    msg += "\"secret\":\"" + webhookSecret + "\","
    msg += "\"name\":\"" + botName + "\","
    msg += "\"strategyTag\":\"" + strategyTag + "\","
    msg += "\"symbol\":\"" + f_stripExchange(_symbol) + "\","
    msg += "\"ticker\":\"" + _symbol + "\","
    msg += "\"timeframe\":\"" + tfToUse + "\","
    msg += "\"signal\":\"CONFIRMED_EXECUTION\","
    msg += "\"order_action\":\"" + _side + "\","
    msg += "\"orderSide\":\"" + _side + "\","
    msg += "\"orderType\":\"" + orderType + "\","
    qtyForAlert = f_alertQty(_side, _price, _s1, _r1)
    qScore = f_execQualityScore(_dist, _rsi, _slope, _state, _side, _macdBelow)
    qBand = f_qualityBand(qScore)
    msg += "\"price\":" + f_json_num(_price) + ","
    msg += "\"quantity\":" + f_json_num(qtyForAlert) + ","
    msg += "\"timeInForce\":\"" + timeInForce + "\","
    msg += "\"goodInOffHours\":\"" + goodInOffHours + "\","
    msg += "\"state\":\"" + f_stateText(_state) + "\","
    msg += "\"rsi\":" + f_json_num(_rsi) + ","
    msg += "\"distATR\":" + f_json_num(_dist) + ","
    msg += "\"macd\":" + f_json_num(_macd) + ","
    msg += "\"hist\":" + f_json_num(_hist) + ","
    msg += "\"cross\":\"" + f_crossText(_cross) + "\","
    msg += "\"slopePct\":" + f_json_num(_slope) + ","
    msg += "\"s1\":" + f_json_num(_s1) + ","
    msg += "\"s2\":" + f_json_num(_s2) + ","
    msg += "\"r1\":" + f_json_num(_r1) + ","
    msg += "\"r2\":" + f_json_num(_r2) + ","
    msg += "\"bar_time\":\"" + str.tostring(time) + "\","
    msg += "\"close\":" + f_json_num(_price) + ","
    msg += "\"exchange\":\"" + f_exchangeOnly(_symbol) + "\","
    msg += "\"quality_score\":" + f_json_num(qScore) + ","
    msg += "\"quality_band\":\"" + qBand + "\","
    msg += "\"weekly_bias\":\"" + (_weeklyBull ? "BULL" : _weeklyBear ? "BEAR" : "NEUTRAL") + "\","
    msg += "\"macd_from_below_zero\":" + (_macdBelow ? "true" : "false") + ","
    msg += "\"timestamp\":\"" + str.tostring(timenow) + "\""
    msg += "}"
    msg
// Q Engine v9: action-priority aligned quality score.
// Q is no longer an independent technical score. It is bounded by the current action class:
// CONFIRMED > WATCH+ > WATCH/EARLY > READY > EXTREME > WAIT.
// Technical factors only rank setups inside their action band.
f_qualityScore(_dist, _rsi, _slope, _state, _risk, _action, _actionInt) =>
    absAction = math.abs(_action)

    base = 25.0
    cap = 40.0

    if absAction == 5
        base := 92.0
        cap := 100.0
    else if absAction == 2 and _actionInt == 1
        base := 76.0
        cap := 88.0
    else if absAction == 2 or absAction == 1
        base := 58.0
        cap := 74.0
    else if absAction == 4
        base := 62.0
        cap := 75.0
    else if math.abs(_state) == 2
        base := 55.0
        cap := 70.0
    else if math.abs(_state) == 3
        base := 45.0
        cap := 60.0
    else
        base := 20.0
        cap := 40.0

    tech = 0.0
    if not na(_dist)
        tech += math.min(math.abs(_dist), 3.0) * 2.0
    if not na(_rsi)
        tech += math.min(math.abs(_rsi - 50.0) / 5.0, 5.0)
    if not na(_slope)
        tech += math.min(math.abs(_slope) * 10.0, 5.0)
    if _actionInt == 1
        tech += 3.0

    penalty = 0.0
    if _risk != 0 or _action == 9
        penalty += 35.0
    if not na(_dist) and math.abs(_dist) > 6.0
        penalty += 5.0
    if not na(_rsi) and (_rsi > 78.0 or _rsi < 22.0)
        penalty += 4.0

    raw = base + tech - penalty
    math.max(0.0, math.min(raw, cap))

f_positionSize(_entry, _stop) =>
    riskAmount = accountSize * (riskPercent / 100.0)
    stopDist = not na(_entry) and not na(_stop) ? math.abs(_entry - _stop) : na
    not na(stopDist) and stopDist > 0 ? riskAmount / stopDist : na

f_tradeStop(_action, _s1, _r1) =>
    _action > 0 ? _s1 : _action < 0 ? _r1 : na

f_tradeTarget(_action, _s2, _r2) =>
    _action > 0 ? _r2 : _action < 0 ? _s2 : na

//====================================================
// ENGINE
//====================================================
f_engine() =>
    emaVal = ta.ema(close, emaLen)
    atrVal = ta.atr(atrLen)
    rsiVal = ta.rsi(close, rsiLen)
    [macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

    distATR = atrVal != 0.0 ? (close - emaVal) / atrVal : na
    slopePct = not na(emaVal[slopeLookback]) and emaVal[slopeLookback] != 0.0 ? ((emaVal - emaVal[slopeLookback]) / emaVal[slopeLookback]) * 100.0 : na

    crossUp = ta.crossover(macdLine, macdSig)
    crossDn = ta.crossunder(macdLine, macdSig)
    crossCode = crossUp ? 1 : crossDn ? -1 : 0

    histUp = macdHist > macdHist[1]
    histDn = macdHist < macdHist[1]

    macdDiff = macdLine - macdSig
    macdSpread = math.abs(macdDiff)
    macdSpreadPrev = math.abs(macdDiff[1])

    longZone = false
    if not na(distATR)
        longZone := distATR <= longMrDist or (distATR >= longContMin and distATR <= longContMax)

    shortZone = false
    if not na(distATR)
        shortZone := distATR >= shortMrDist or (distATR >= shortContMin and distATR <= shortContMax)

    hh = ta.highest(high, fibLookback)
    ll = ta.lowest(low, fibLookback)
    fibRange = hh - ll
    fibPos = fibRange != 0.0 ? (close - ll) / fibRange : na

    fib236 = ll + fibRange * 0.236
    fib382 = ll + fibRange * 0.382
    fib500 = ll + fibRange * 0.500
    fib618 = ll + fibRange * 0.618
    fib786 = ll + fibRange * 0.786

    d236 = not na(fibPos) ? math.abs(fibPos - 0.236) : na
    d382 = not na(fibPos) ? math.abs(fibPos - 0.382) : na
    d500 = not na(fibPos) ? math.abs(fibPos - 0.500) : na
    d618 = not na(fibPos) ? math.abs(fibPos - 0.618) : na
    d786 = not na(fibPos) ? math.abs(fibPos - 0.786) : na

    fibCode = 236
    minDist = d236
    if not na(d382) and (na(minDist) or d382 < minDist)
        minDist := d382
        fibCode := 382
    if not na(d500) and (na(minDist) or d500 < minDist)
        minDist := d500
        fibCode := 500
    if not na(d618) and (na(minDist) or d618 < minDist)
        minDist := d618
        fibCode := 618
    if not na(d786) and (na(minDist) or d786 < minDist)
        fibCode := 786

    zoneLo = fibCode == 236 ? ll : fibCode == 382 ? fib236 : fibCode == 500 ? fib382 : fibCode == 618 ? fib500 : fib618
    zoneHi = fibCode == 236 ? fib382 : fibCode == 382 ? fib500 : fibCode == 500 ? fib618 : fibCode == 618 ? fib786 : hh

    atrStep = atrVal * srAtrStep
    s1 = zoneLo
    s2 = zoneLo - atrStep
    r1 = zoneHi
    r2 = zoneHi + atrStep

    if close < zoneLo
        r1 := zoneLo
        r2 := zoneHi
        s1 := zoneLo - atrStep
        s2 := zoneLo - atrStep * 2.0
    else if close > zoneHi
        s1 := zoneHi
        s2 := zoneLo
        r1 := zoneHi + atrStep
        r2 := zoneHi + atrStep * 2.0

    extremeLong = not na(distATR) and distATR <= extremeDistLong
    extremeShort = not na(distATR) and distATR >= extremeDistShort

    readyLong = longZone and not crossUp and macdLine < macdSig and histUp and rsiVal >= readyRsiLongMin and macdSpreadPrev > 0 and macdSpread <= macdSpreadPrev * (1.0 - readyNearCrossFrac)
    readyShort = shortZone and not crossDn and macdLine > macdSig and histDn and rsiVal <= readyRsiShortMax and macdSpreadPrev > 0 and macdSpread <= macdSpreadPrev * (1.0 - readyNearCrossFrac)

    trendLong = not readyLong and not extremeLong and not na(distATR) and not na(slopePct) and distATR >= longContMin and distATR <= longContMax and close >= emaVal and slopePct >= -trendSlopeTol and macdLine >= -trendMacdTol and rsiVal >= trendRsiLongMin
    trendShort = not readyShort and not extremeShort and not na(distATR) and not na(slopePct) and distATR >= shortContMin and distATR <= shortContMax and close <= emaVal and slopePct <= trendSlopeTol and macdLine <= trendMacdTol and rsiVal <= trendRsiShortMax

    stateCode = readyLong ? 2 : readyShort ? -2 : extremeLong ? 3 : extremeShort ? -3 : trendLong ? 1 : trendShort ? -1 : 0

    strictRunawayLong = not na(distATR) and not na(slopePct) and distATR > strictRunawayDistLong and rsiVal > strictRunawayRsiLong and slopePct > strictRunawaySlopeLong
    strictRunawayShort = not na(distATR) and not na(slopePct) and distATR < strictRunawayDistShort and rsiVal < strictRunawayRsiShort and slopePct < strictRunawaySlopeShort
    riskCode = strictRunawayLong ? 1 : strictRunawayShort ? -1 : 0

    // =======================================================
    // CONFIRMED BUY / SELL — Günlük TF için 5 katman filtre
    // =======================================================
    // K1: State integrity — crossUp anında stateCode bozulur,
    //     bir önceki barın state'ini kullan
    prevStateCode = nz(stateCode[1], 0)

    // Kaldıraç A: son confirmWindowBars bar içinde READY(±2)/EXTREME(±3) oldu mu?
    // barsSinceReady* = kaç bar önce (en yakın eşleşme); na ise pencerede yok.
    // Cross barının (i=0) kendi state'i bozuk olabileceği için i=1'den başlar (K1).
    int barsSinceReadyLong  = na
    int barsSinceReadyShort = na
    for i = 1 to confirmWindowBars
        si = nz(stateCode[i], 0)
        if na(barsSinceReadyLong)  and (si == 2 or si == 3)
            barsSinceReadyLong := i
        if na(barsSinceReadyShort) and (si == -2 or si == -3)
            barsSinceReadyShort := i

    // K2: Momentum kalitesi — 2 ardışık histogram büyümesi (3'ten düşürüldü)
    histDoubleUp = macdHist > macdHist[1] and macdHist[1] > macdHist[2]
    histDoubleDn = macdHist < macdHist[1] and macdHist[1] < macdHist[2]

    // K2: MACD sıfır çizgisi pozisyonu — negatif bölgeden crossUp daha güçlü
    macdFromBelowZero = macdLine[1] < 0.0
    macdFromAboveZero = macdLine[1] > 0.0

    // K3: Slope şartı — state'e göre ikiye ayrılıyor
    // READY/EXTREME (dönüş setup'ı): EMA hâlâ negatif olabilir, hafif negatife izin ver
    // TREND (devam setup'ı): pozitif eğim zorunlu
    slopeOkBuy  = not na(barsSinceReadyLong)  ? slopePct >= -0.10 : slopePct >= 0.05
    slopeOkSell = not na(barsSinceReadyShort) ? slopePct <= 0.10 : slopePct <= -0.05

    // isConfirmedBuy — düzeltilmiş 5 katman filtre
    // K4 haftalık bias: f_engine dışında hesaplanıp parametre olarak geçirilir
    isConfirmedBuy =
         crossUp
         and not na(barsSinceReadyLong)
         and histDoubleUp
         and rsiVal >= 43.0
         and not na(slopePct) and slopeOkBuy
         and not na(distATR) and distATR >= -4.0 and distATR <= 1.5
         and (fibCode == 236 or fibCode == 382 or fibCode == 500)
         and riskCode == 0

    // isConfirmedSell — düzeltilmiş 5 katman filtre
    isConfirmedSell =
         crossDn
         and not na(barsSinceReadyShort)
         and histDoubleDn
         and rsiVal <= 57.0
         and not na(slopePct) and slopeOkSell
         and not na(distATR) and distATR >= -1.5 and distATR <= 4.0
         and (fibCode == 786 or fibCode == 618 or fibCode == 500)
         and riskCode == 0

    spreadCompressed = macdSpreadPrev > 0 and macdSpread <= macdSpreadPrev * watchPlusCompression
    watchLong = stateCode == 2 or stateCode == 3
    watchShort = stateCode == -2 or stateCode == -3

    actionIntensity = 0
    if watchLong and not na(distATR) and not na(slopePct) and distATR <= -watchPlusDist and (fibCode == 236 or fibCode == 382) and histUp and spreadCompressed and slopePct <= watchPlusSlopeWeakLong
        actionIntensity := 1
    if watchShort and not na(distATR) and not na(slopePct) and distATR >= watchPlusDist and (fibCode == 786 or fibCode == 618) and histDn and spreadCompressed and slopePct >= watchPlusSlopeWeakShort
        actionIntensity := 1

    actionCode = 0
    if strictRunawayLong or strictRunawayShort
        actionCode := 9
    else if isConfirmedBuy
        actionCode := 5
    else if isConfirmedSell
        actionCode := -5
    else if crossUp
        actionCode := 4
    else if crossDn
        actionCode := -4
    else if watchLong
        actionCode := actionIntensity == 1 ? 2 : 1
    else if watchShort
        actionCode := actionIntensity == 1 ? -2 : -1

    prevAction = nz(actionCode[1], 0)

    // 10 bar re-trigger koruması (günlük TF = 2 haftalık pencere)
    recentBuyBars  = actionCode[1]==5 or actionCode[2]==5 or actionCode[3]==5 or actionCode[4]==5 or actionCode[5]==5
                     or actionCode[6]==5 or actionCode[7]==5 or actionCode[8]==5 or actionCode[9]==5 or actionCode[10]==5
    recentSellBars = actionCode[1]==-5 or actionCode[2]==-5 or actionCode[3]==-5 or actionCode[4]==-5 or actionCode[5]==-5
                     or actionCode[6]==-5 or actionCode[7]==-5 or actionCode[8]==-5 or actionCode[9]==-5 or actionCode[10]==-5

    // Kalite kapısı: alarm ancak minQualityScore üzerinde ise ateşlenir
    confirmedQualityBuy  = f_qualityScore(distATR, rsiVal, slopePct, stateCode, riskCode, actionCode, actionIntensity)
    confirmedQualitySell = f_qualityScore(distATR, rsiVal, slopePct, stateCode, riskCode, actionCode, actionIntensity)

    confirmedBuyEvent  = actionCode == 5  and not recentBuyBars  and confirmedQualityBuy  >= minQualityScore ? 1 : 0
    confirmedSellEvent = actionCode == -5 and not recentSellBars and confirmedQualitySell >= minQualityScore ? 1 : 0

    entryTrigger = actionCode > 0 ? high[1] : actionCode < 0 ? low[1] : na

    rankScore = 0.0
    if not na(distATR)
        rankScore += math.abs(distATR) * 100.0
    if stateCode == 2 or stateCode == -2
        rankScore += readyRankBoost
    if stateCode == 3 or stateCode == -3
        rankScore += extremeRankBoost
    if actionIntensity == 1
        rankScore += 70.0
    if actionCode == 5 or actionCode == -5
        rankScore += 150.0
    if actionCode == 4 or actionCode == -4
        rankScore += 40.0
    if riskCode != 0
        rankScore -= 300.0

    [close, rsiVal, distATR, macdLine, macdHist, slopePct, fibCode, s1, s2, r1, r2, crossCode, stateCode, riskCode, actionCode, actionIntensity, rankScore, confirmedBuyEvent, confirmedSellEvent, entryTrigger, macdFromBelowZero]

