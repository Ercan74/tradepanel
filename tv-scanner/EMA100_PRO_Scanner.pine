//@version=5
indicator("EMA100 PRO Scanner CLEAN v5.4 Daily - BIST 30 Preset Groups", overlay=false, dynamic_requests=true)

//====================================================
// INPUTS
//====================================================
groupCore   = "Core"
groupZone   = "Zones"
groupFilter = "Filters"
groupState  = "State"
groupAction = "Action"
groupRisk   = "Risk"
groupSR     = "Support / Resistance"
groupTable  = "Table"
groupAlert  = "Alerts"

// Core
scanTf        = input.timeframe("D", "Scan Timeframe (blank = chart timeframe)", group=groupCore)
emaLen        = input.int(100, "EMA Length", minval=1, group=groupCore)
atrLen        = input.int(14, "ATR Length", minval=1, group=groupCore)
rsiLen        = input.int(14, "RSI Length", minval=1, group=groupCore)
macdFast      = input.int(12, "MACD Fast", minval=1, group=groupCore)
macdSlow      = input.int(26, "MACD Slow", minval=1, group=groupCore)
macdSignalLen = input.int(9, "MACD Signal", minval=1, group=groupCore)
slopeLookback = input.int(10, "EMA Slope Lookback", minval=1, group=groupCore)
fibLookback   = input.int(60, "FIB Swing Lookback", minval=20, group=groupCore)

// Zones
longMrDist    = input.float(-1.5, "Long MR distATR <=", step=0.1, group=groupZone)
longContMin   = input.float(0.0, "Long Continuation Min", step=0.1, group=groupZone)
longContMax   = input.float(0.5, "Long Continuation Max", step=0.1, group=groupZone)
shortMrDist   = input.float(1.5, "Short MR distATR >=", step=0.1, group=groupZone)
shortContMin  = input.float(-0.5, "Short Continuation Min", step=0.1, group=groupZone)
shortContMax  = input.float(0.0, "Short Continuation Max", step=0.1, group=groupZone)

// Filters
longRsiMin    = input.float(45.0, "Long RSI Min", step=0.1, group=groupFilter)
shortRsiMax   = input.float(55.0, "Short RSI Max", step=0.1, group=groupFilter)
longSlopeMin  = input.float(0.05, "Long Slope Min", step=0.01, group=groupFilter)
shortSlopeMax = input.float(0.25, "Short Slope Max", step=0.01, group=groupFilter)

// State
extremeDistLong    = input.float(-3.0, "Extreme Long <=", step=0.1, group=groupState)
extremeDistShort   = input.float(3.0, "Extreme Short >=", step=0.1, group=groupState)
readyRsiLongMin    = input.float(32.0, "Ready Long RSI Min", step=0.1, group=groupState)
readyRsiShortMax   = input.float(68.0, "Ready Short RSI Max", step=0.1, group=groupState)
trendRsiLongMin    = input.float(48.0, "Trend Long RSI Min", step=0.1, group=groupState)
trendRsiShortMax   = input.float(52.0, "Trend Short RSI Max", step=0.1, group=groupState)
readyNearCrossFrac = input.float(0.25, "Ready Spread Compression", minval=0.05, maxval=1.0, step=0.05, group=groupState)
trendMacdTol       = input.float(0.10, "Trend MACD Tolerance", step=0.001, group=groupState)
trendSlopeTol      = input.float(0.05, "Trend Slope Tolerance", step=0.01, group=groupState)
// Kaldıraç A: CONFIRMED için state→cross zamanlama penceresi. Cross'un READY/EXTREME
// ile AYNI bara (1 bar) denk gelme zorunluluğu çoğu kurulumu eliyordu; N bar tolerans
// huniyi genişletir. Kalite filtrelemesi downstream (webhook skoru + SWAP) yapar.
confirmWindowBars  = input.int(3, "Confirm State→Cross Window (bars)", minval=1, maxval=10, group=groupState)

// Action
watchPlusDist           = input.float(3.0, "Watch+ distATR", step=0.1, group=groupAction)
watchPlusCompression    = input.float(0.60, "Watch+ Spread Compression", minval=0.10, maxval=1.00, step=0.05, group=groupAction)
watchPlusSlopeWeakLong  = input.float(0.05, "Watch+ Long Slope Weak Max", step=0.01, group=groupAction)
watchPlusSlopeWeakShort = input.float(-0.05, "Watch+ Short Slope Weak Min", step=0.01, group=groupAction)
readyRankBoost          = input.float(220.0, "READY Rank Boost", step=10.0, group=groupAction)
extremeRankBoost        = input.float(80.0, "EXTREME Rank Boost", step=10.0, group=groupAction)

// Risk
strictRunawayDistLong   = input.float(6.0, "Strict Runaway Long distATR >=", step=0.1, group=groupRisk)
strictRunawayDistShort  = input.float(-6.0, "Strict Runaway Short distATR <=", step=0.1, group=groupRisk)
strictRunawayRsiLong    = input.float(80.0, "Strict Runaway Long RSI >=", step=0.1, group=groupRisk)
strictRunawayRsiShort   = input.float(20.0, "Strict Runaway Short RSI <=", step=0.1, group=groupRisk)
strictRunawaySlopeLong  = input.float(0.5, "Strict Runaway Long Slope >=", step=0.01, group=groupRisk)
strictRunawaySlopeShort = input.float(-0.5, "Strict Runaway Short Slope <=", step=0.01, group=groupRisk)

// Trader Risk / Position Sizing
accountSize     = input.float(100000.0, "Account Size", minval=1, step=1000, group=groupRisk)
riskPercent     = input.float(1.0, "Risk Per Trade %", minval=0.1, maxval=10.0, step=0.1, group=groupRisk)
minQualityScore = input.float(78.0, "Min Quality Score", minval=0.0, maxval=100.0, step=1.0, group=groupRisk)
useAutoSizeForAlert = input.bool(true, "Use Auto Position Size In Webhook Quantity", group=groupRisk)
nearEntryPct = input.float(0.35, "Near Entry Threshold %", minval=0.05, maxval=2.0, step=0.05, group=groupRisk)
maxExposurePct = input.float(100.0, "Max Total Exposure %", minval=10.0, maxval=500.0, step=10.0, group=groupRisk)
capPositionSizeToMaxExposure = input.bool(true, "Cap Position Sizes To Max Exposure", group=groupRisk)

// Support / Resistance
srAtrStep = input.float(1.0, "ATR Step For S/R Expansion", minval=0.1, maxval=5.0, step=0.1, group=groupSR)

// Table
mainTablePos    = input.string("top_left", "Main Table Position", options=["top_left", "top_right", "bottom_left", "bottom_right"], group=groupTable)
textSizeInput   = input.string("small", "Main Text Size", options=["tiny", "small", "normal"], group=groupTable)
topNRows        = input.int(30, "Top N Rows", minval=1, maxval=30, group=groupTable)
directionFilter = input.string("ALL", "Direction Filter", options=["ALL", "LONG_ONLY", "SHORT_ONLY"], group=groupTable)

// Alerts
enableExecutionAlerts = input.bool(true, "Enable CONFIRMED_EXECUTION Alerts", group=groupAlert)
alertOnlyOnBarClose   = input.bool(true, "Execution Alert Only On Bar Close", group=groupAlert)
botName               = input.string("EMA100_EXECUTION", "Bot Name", group=groupAlert)
strategyTag           = input.string("EMA100_PRO_V6_9", "Strategy Tag", group=groupAlert)
webhookSecret         = input.string("ema100_secret_2026", "Webhook Secret", group=groupAlert)
orderType             = input.string("mktbest", "orderType", group=groupAlert)
defaultQty            = input.float(1.0, "quantity", step=1.0, group=groupAlert)
timeInForce           = input.string("day", "timeInForce", group=groupAlert)
goodInOffHours        = input.string("0", "goodInOffHours", group=groupAlert)

// Symbols
groupPreset = "BIST 30 Preset Lists"
presetList = input.string("CUSTOM", "Scanner List", options=["CUSTOM", "BIST 01: ACSEL-ANHYT (30)", "BIST 02: ANSGR-BIMAS (30)", "BIST 03: BINHO-CVKMD (30)", "BIST 04: CWENE-ECILC (30)", "BIST 05: ECZYT-FONET (30)", "BIST 06: FORMT-HKTM (30)", "BIST 07: HLGYO-IZINV (30)", "BIST 08: IZMDC-KRDMD (30)", "BIST 09: KRONT-MEKAG (30)", "BIST 10: MEPET-OTKAR (30)", "BIST 11: OTTO-PSGYO (30)", "BIST 12: QUAGR-SILVR (30)", "BIST 13: SISE-TRALT (30)", "BIST 14: TRCAS-VESTL (30)", "BIST 15: VKFYO-ZRGYO (last)"], group=groupPreset)
groupSym1   = "Custom Symbols 1-5"
groupSym2   = "Custom Symbols 6-10"
groupSym3   = "Custom Symbols 11-15"
groupSym4   = "Custom Symbols 16-20"
sym1  = input.symbol("BIST:SISE", "Symbol 1", group=groupSym1)
sym2  = input.symbol("BIST:EREGL", "Symbol 2", group=groupSym1)
sym3  = input.symbol("BIST:KCHOL", "Symbol 3", group=groupSym1)
sym4  = input.symbol("BIST:PETKM", "Symbol 4", group=groupSym1)
sym5  = input.symbol("BIST:YKBNK", "Symbol 5", group=groupSym1)
sym6  = input.symbol("BIST:AKBNK", "Symbol 6", group=groupSym2)
sym7  = input.symbol("BIST:THYAO", "Symbol 7", group=groupSym2)
sym8  = input.symbol("BIST:TUPRS", "Symbol 8", group=groupSym2)
sym9  = input.symbol("BIST:TCELL", "Symbol 9", group=groupSym2)
sym10  = input.symbol("BIST:ASELS", "Symbol 10", group=groupSym2)
sym11  = input.symbol("BIST:ASTOR", "Symbol 11", group=groupSym3)
sym12  = input.symbol("BIST:BIMAS", "Symbol 12", group=groupSym3)
sym13  = input.symbol("BIST:ENKAI", "Symbol 13", group=groupSym3)
sym14  = input.symbol("BIST:FROTO", "Symbol 14", group=groupSym3)
sym15  = input.symbol("BIST:GARAN", "Symbol 15", group=groupSym3)
sym16  = input.symbol("BIST:ISCTR", "Symbol 16", group=groupSym4)
sym17  = input.symbol("BIST:KRDMD", "Symbol 17", group=groupSym4)
sym18  = input.symbol("BIST:SAHOL", "Symbol 18", group=groupSym4)
sym19  = input.symbol("BIST:TOASO", "Symbol 19", group=groupSym4)
sym20  = input.symbol("BIST:VAKBN", "Symbol 20", group=groupSym4)
scanSym1 = presetList == "CUSTOM" ? sym1 : presetList == "BIST 01: ACSEL-ANHYT (30)" ? "BIST:ACSEL" : presetList == "BIST 02: ANSGR-BIMAS (30)" ? "BIST:ANSGR" : presetList == "BIST 03: BINHO-CVKMD (30)" ? "BIST:BINHO" : presetList == "BIST 04: CWENE-ECILC (30)" ? "BIST:CWENE" : presetList == "BIST 05: ECZYT-FONET (30)" ? "BIST:ECZYT" : presetList == "BIST 06: FORMT-HKTM (30)" ? "BIST:FORMT" : presetList == "BIST 07: HLGYO-IZINV (30)" ? "BIST:HLGYO" : presetList == "BIST 08: IZMDC-KRDMD (30)" ? "BIST:IZMDC" : presetList == "BIST 09: KRONT-MEKAG (30)" ? "BIST:KRONT" : presetList == "BIST 10: MEPET-OTKAR (30)" ? "BIST:MEPET" : presetList == "BIST 11: OTTO-PSGYO (30)" ? "BIST:OTTO" : presetList == "BIST 12: QUAGR-SILVR (30)" ? "BIST:QUAGR" : presetList == "BIST 13: SISE-TRALT (30)" ? "BIST:SISE" : presetList == "BIST 14: TRCAS-VESTL (30)" ? "BIST:TRCAS" : presetList == "BIST 15: VKFYO-ZRGYO (last)" ? "BIST:VKFYO" : sym1
scanSym2 = presetList == "CUSTOM" ? sym2 : presetList == "BIST 01: ACSEL-ANHYT (30)" ? "BIST:ADEL" : presetList == "BIST 02: ANSGR-BIMAS (30)" ? "BIST:ARCLK" : presetList == "BIST 03: BINHO-CVKMD (30)" ? "BIST:BIZIM" : presetList == "BIST 04: CWENE-ECILC (30)" ? "BIST:DAGHL" : presetList == "BIST 05: ECZYT-FONET (30)" ? "BIST:EDATA" : presetList == "BIST 06: FORMT-HKTM (30)" ? "BIST:FRIGO" : presetList == "BIST 07: HLGYO-IZINV (30)" ? "BIST:HTTBT" : presetList == "BIST 08: IZMDC-KRDMD (30)" ? "BIST:JANTS" : presetList == "BIST 09: KRONT-MEKAG (30)" ? "BIST:KRPLS" : presetList == "BIST 10: MEPET-OTKAR (30)" ? "BIST:MERCN" : presetList == "BIST 11: OTTO-PSGYO (30)" ? "BIST:OYAKC" : presetList == "BIST 12: QUAGR-SILVR (30)" ? "BIST:RALYH" : presetList == "BIST 13: SISE-TRALT (30)" ? "BIST:SKBNK" : presetList == "BIST 14: TRCAS-VESTL (30)" ? "BIST:TRENJ" : presetList == "BIST 15: VKFYO-ZRGYO (last)" ? "BIST:VKGYO" : sym2
