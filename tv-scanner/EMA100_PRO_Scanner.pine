f_applyExposureCap()
f_sort()

//====================================================
// TABLE
//====================================================
mainTxt = f_textSize(textSizeInput)
var table mainDash = table.new(f_tablePos(mainTablePos), 14, 33, border_width=1, frame_width=1, frame_color=color.new(color.white, 70))

f_clearMainTable() =>
    for r = 0 to 32
        for c = 0 to 13
            table.cell(mainDash, c, r, "", bgcolor=color.new(color.black, 100), text_size=mainTxt)

f_drawHeader() =>
    headBg = color.new(color.rgb(80, 140, 255), 25)
    table.cell(mainDash, 0, 1, "SYMBOL", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 1, 1, "PRICE", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 2, 1, "distATR", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 3, 1, "RSI", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 4, 1, "MACD", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 5, 1, "FIB", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 6, 1, "SLOPE", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 7, 1, "CROSS", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 8, 1, "STATE", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 9, 1, "ACTION", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 10, 1, "ENTRY", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 11, 1, "SL", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 12, 1, "TP", text_color=color.black, bgcolor=headBg, text_size=mainTxt)
    table.cell(mainDash, 13, 1, "Q", text_color=color.black, bgcolor=headBg, text_size=mainTxt)

f_drawRow(_row, _sym, _price, _dist, _rsi, _macd, _hist, _fib, _slope, _s1, _s2, _r1, _r2, _cross, _state, _risk, _action, _actionInt, _entry, _stop, _target, _quality, _size) =>
    baseBg = color.new(color.rgb(225, 230, 238), 0)
    crossBg = _cross == 1 ? color.new(color.green, 75) : _cross == -1 ? color.new(color.red, 75) : color.new(color.gray, 88)
    stateBg = f_stateBg(_state)
    actionBg = f_actionBg(_action, _actionInt)
    actionTc = color.black
    qBg = _quality >= 80 ? color.new(color.green, 68) : _quality >= minQualityScore ? color.new(color.lime, 78) : color.new(color.orange, 75)

    table.cell(mainDash, 0, _row, _sym, text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 1, _row, f_fmtPrice(_price), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 2, _row, f_fmt2(_dist), text_color=color.black, bgcolor=f_distBg(_dist), text_size=mainTxt)
    table.cell(mainDash, 3, _row, f_fmt2(_rsi), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 4, _row, f_fmt3(_macd) + " | " + f_fmt3(_hist), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 5, _row, f_fibZoneText(_fib), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 6, _row, f_fmt2(_slope), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 7, _row, f_crossText(_cross), text_color=color.black, bgcolor=crossBg, text_size=mainTxt)
    table.cell(mainDash, 8, _row, f_stateText(_state), text_color=color.black, bgcolor=stateBg, text_size=mainTxt)
    table.cell(mainDash, 9, _row, f_actionText(_action, _actionInt), text_color=actionTc, bgcolor=actionBg, text_size=mainTxt)
    table.cell(mainDash, 10, _row, f_fmtPrice(_entry), text_color=color.black, bgcolor=baseBg, text_size=mainTxt)
    table.cell(mainDash, 11, _row, f_fmtPrice(_stop), text_color=color.black, bgcolor=color.new(color.red, 72), text_size=mainTxt)
    table.cell(mainDash, 12, _row, f_fmtPrice(_target), text_color=color.black, bgcolor=color.new(color.green, 72), text_size=mainTxt)
    table.cell(mainDash, 13, _row, f_fmt2(_quality), text_color=color.black, bgcolor=qBg, text_size=mainTxt)




if barstate.islast
    f_clearMainTable()
    f_drawHeader()
    maxRows = math.min(array.size(rowSymbols), topNRows)
    for row = 0 to maxRows - 1
        f_drawRow(
             row + 2,
             array.get(rowSymbols, row),
             array.get(rowPrice, row),
             array.get(rowDist, row),
             array.get(rowRsi, row),
             array.get(rowMacd, row),
             array.get(rowHist, row),
             array.get(rowFib, row),
             array.get(rowSlope, row),
             array.get(rowS1, row),
             array.get(rowS2, row),
             array.get(rowR1, row),
             array.get(rowR2, row),
             array.get(rowCross, row),
             array.get(rowState, row),
             array.get(rowRisk, row),
             array.get(rowAction, row),
             array.get(rowActionInt, row),
             array.get(rowEntry, row),
             array.get(rowStop, row),
             array.get(rowTarget, row),
             array.get(rowQuality, row),
             array.get(rowSize, row)
         )

plot(na, title="Scanner Ready", display=display.none)
