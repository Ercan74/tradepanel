//====================================================
// WEEKLY BIAS — tek seferlik, chart sembolü üzerinden
// (request limit aşımını önlemek için engine dışında)
//====================================================
_wkClose = request.security(syminfo.tickerid, "W", close, ignore_invalid_symbol=true)
_wkEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), ignore_invalid_symbol=true)
chartWeeklyBull = not na(_wkClose) and not na(_wkEma50) and _wkClose > _wkEma50
chartWeeklyBear = not na(_wkClose) and not na(_wkEma50) and _wkClose < _wkEma50
weeklyBiasStr   = chartWeeklyBull ? "BULL" : chartWeeklyBear ? "BEAR" : "NEUTRAL"

//====================================================
// ALERTS
//====================================================
anyBuyExecution = s1buy == 1 or s2buy == 1 or s3buy == 1 or s4buy == 1 or s5buy == 1 or s6buy == 1 or s7buy == 1 or s8buy == 1 or s9buy == 1 or s10buy == 1 or s11buy == 1 or s12buy == 1 or s13buy == 1 or s14buy == 1 or s15buy == 1 or s16buy == 1 or s17buy == 1 or s18buy == 1 or s19buy == 1 or s20buy == 1 or s21buy == 1 or s22buy == 1 or s23buy == 1 or s24buy == 1 or s25buy == 1 or s26buy == 1 or s27buy == 1 or s28buy == 1 or s29buy == 1 or s30buy == 1
anySellExecution = s1sell == 1 or s2sell == 1 or s3sell == 1 or s4sell == 1 or s5sell == 1 or s6sell == 1 or s7sell == 1 or s8sell == 1 or s9sell == 1 or s10sell == 1 or s11sell == 1 or s12sell == 1 or s13sell == 1 or s14sell == 1 or s15sell == 1 or s16sell == 1 or s17sell == 1 or s18sell == 1 or s19sell == 1 or s20sell == 1 or s21sell == 1 or s22sell == 1 or s23sell == 1 or s24sell == 1 or s25sell == 1 or s26sell == 1 or s27sell == 1 or s28sell == 1 or s29sell == 1 or s30sell == 1

alertcondition(anyBuyExecution, "CONFIRMED BUY", "CONFIRMED BUY signal detected")
alertcondition(anySellExecution, "CONFIRMED SELL", "CONFIRMED SELL signal detected")

canExecutionAlert = alertOnlyOnBarClose ? barstate.isconfirmed : (barstate.isrealtime or barstate.isconfirmed)

if enableExecutionAlerts and canExecutionAlert
    if s1buy == 1
        alert(f_execJson(scanSym1, "BUY", s1c, s1r, s1d, s1m, s1h, s1x, s1s, s1st, s1s1, s1s2, s1r1, s1r2, chartWeeklyBull, chartWeeklyBear, s1mfb), alert.freq_once_per_bar_close)
    if s2buy == 1
        alert(f_execJson(scanSym2, "BUY", s2c, s2r, s2d, s2m, s2h, s2x, s2s, s2st, s2s1, s2s2, s2r1, s2r2, chartWeeklyBull, chartWeeklyBear, s2mfb), alert.freq_once_per_bar_close)
    if s3buy == 1
        alert(f_execJson(scanSym3, "BUY", s3c, s3r, s3d, s3m, s3h, s3x, s3s, s3st, s3s1, s3s2, s3r1, s3r2, chartWeeklyBull, chartWeeklyBear, s3mfb), alert.freq_once_per_bar_close)
    if s4buy == 1
