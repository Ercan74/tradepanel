    if s5buy == 1
        alert(f_execJson(scanSym5, "BUY", s5c, s5r, s5d, s5m, s5h, s5x, s5s, s5st, s5s1, s5s2, s5r1, s5r2, chartWeeklyBull, chartWeeklyBear, s5mfb), alert.freq_once_per_bar_close)
    if s6buy == 1
        alert(f_execJson(scanSym6, "BUY", s6c, s6r, s6d, s6m, s6h, s6x, s6s, s6st, s6s1, s6s2, s6r1, s6r2, chartWeeklyBull, chartWeeklyBear, s6mfb), alert.freq_once_per_bar_close)
    if s7buy == 1
        alert(f_execJson(scanSym7, "BUY", s7c, s7r, s7d, s7m, s7h, s7x, s7s, s7st, s7s1, s7s2, s7r1, s7r2, chartWeeklyBull, chartWeeklyBear, s7mfb), alert.freq_once_per_bar_close)
    if s8buy == 1
        alert(f_execJson(scanSym8, "BUY", s8c, s8r, s8d, s8m, s8h, s8x, s8s, s8st, s8s1, s8s2, s8r1, s8r2, chartWeeklyBull, chartWeeklyBear, s8mfb), alert.freq_once_per_bar_close)
    if s9buy == 1
        alert(f_execJson(scanSym9, "BUY", s9c, s9r, s9d, s9m, s9h, s9x, s9s, s9st, s9s1, s9s2, s9r1, s9r2, chartWeeklyBull, chartWeeklyBear, s9mfb), alert.freq_once_per_bar_close)
    if s10buy == 1
        alert(f_execJson(scanSym10, "BUY", s10c, s10r, s10d, s10m, s10h, s10x, s10s, s10st, s10s1, s10s2, s10r1, s10r2, chartWeeklyBull, chartWeeklyBear, s10mfb), alert.freq_once_per_bar_close)
    if s11buy == 1
        alert(f_execJson(scanSym11, "BUY", s11c, s11r, s11d, s11m, s11h, s11x, s11s, s11st, s11s1, s11s2, s11r1, s11r2, chartWeeklyBull, chartWeeklyBear, s11mfb), alert.freq_once_per_bar_close)
    if s12buy == 1
        alert(f_execJson(scanSym12, "BUY", s12c, s12r, s12d, s12m, s12h, s12x, s12s, s12st, s12s1, s12s2, s12r1, s12r2, chartWeeklyBull, chartWeeklyBear, s12mfb), alert.freq_once_per_bar_close)
    if s13buy == 1
