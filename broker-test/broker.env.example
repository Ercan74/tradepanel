# Broker gizli config — 'broker.env' olarak KOPYALA ve doldur.
# broker.env .gitignore'da; ASLA commit edilmez. Değerleri script'e gömme.

# ── MatriksIQ "Dışarıdan Emir Kabulü" (AKTİF YÖN, 2026-08) ──────────────────
# Lokal soket — MatriksIQ lisansı aktifken bu portu açar (aynı PC).
MATRIKS_HOST=127.0.0.1
MATRIKS_PORT=18890
MATRIKS_KEEPALIVE_SEC=30
# BrokageId / AccountId GÖMÜLMEZ — runtime'da ListAccounts(1) yanıtından gelir.

# ── (ESKİ) Osmanlı-webhook — terk edildi, yalnız broker_sender.py için ──────
BROKER_WEBHOOK_URL=
BROKER_API_KEY=
BROKER_TOKEN=
